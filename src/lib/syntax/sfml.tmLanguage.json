{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Super Factory Manager Language",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.redstone.sfml",
          "match": "(?i)\\b(REDSTONE|PULSE)\\b"
        },
        {
          "name": "keyword.other.strategy.sfml",
          "match": "(?i)\\bROUND\\s+ROBIN\\s+BY\\s+(BLOCK|LABEL)\\b"
        },
        {
          "name": "keyword.other.core.sfml",
          "match": "(?i)\\b(NAME|EVERY|DO|END|IF|ELSE|THEN|HAS|TRUE|FALSE|FORGET)\\b"
        },
        {
          "name": "keyword.other.io.sfml",
          "match": "(?i)\\b(INPUT|FROM|OUTPUT|TO)\\b"
        },
        {
          "name": "keyword.other.position.sfml",
          "match": "(?i)\\b(TOP|BOTTOM|LEFT|RIGHT|FRONT|BACK|WEST|EAST|NORTH|SOUTH|SIDE|EACH)\\b"
        },
        {
          "name": "keyword.other.logic.sfml",
          "match": "(?i)\\b(TICKS|TICK|SOME|RETAIN|SLOTS|EXCEPT|SECOND|OVERALL|LONE|ONE|IN|EMPTY|SECONDS|SLOT|AND|NOT|OR|GLOBAL|G)\\b"
        },
        {
          "name": "keyword.operator.logic.sfml",
          "match": "(?i)\\b(GE|LE|EQ|GT|LT|PLUS|WITH|WITHOUT|TAG)\\b"
        },
        {
          "name": "keyword.operator.logic.sfml",
          "match": "(?<=\\s)(=|>|<|<=|>=)(?=\\s)"
        },
        {
          "name": "variable.parameter.sfml",
          "match": "(?i)\\b(FLUID|GAS|ITEM|FE)\\b\\s*:\\s*(\\S+)"
        },
        {
          "name": "variable.parameter.sfml",
          "match": "(?i)(?<=INPUT\\s)(.*?)\\s+(?=FROM|EXCEPT|RETAIN|WITH|WITHOUT)"
        },
        {
          "name": "variable.parameter.sfml",
          "match": "(?i)(?<=OUTPUT\\s)(.*?)\\s+(?=TO|EXCEPT|RETAIN|WITH|WITHOUT)"
        },
        {
          "name": "keyword.other.star.sfml",
          "match": "\\*"
        },
        {
          "name": "keyword.other.sfml",
          "match": "(?i)\\b(MOVE|WHERE|SLOTS|SELF|SECONDS|WORLD|PROGRAM)\\b"
        },
        {
          "name": "keyword.control.flow.sfml",
          "match": "(?i)\\b(IF|ELSE|THEN|DO|END)\\b"
        },
        {
          "name": "invalid.illegal.redstone.sfml",
          "match": "(?i)(?<=\\bEVERY\\s+)REDSTONE(?=\\s+PULSE\\b)"
        },
        {
          "name": "invalid.illegal.redstone.sfml",
          "match": "(?i)(?<=\\bIF\\s+)REDSTONE(?=\\s+(EQ|GT|LT|LE|GE)\\b)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sfml"
            }
          },
          "end": "\\n",
          "name": "comment.line.double-dash.sfml"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tick.sfml",
          "match": "\\b\\d+(?=\\s*[gG]\\b)"
        },
        {
          "name": "constant.numeric.sfml",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sfml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sfml",
          "match": "\\\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.sfml",
          "match": "[,\\-:/]"
        },
        {
          "name": "keyword.operator.symbol.sfml",
          "match": "[#+]"
        }
      ]
    }
  },
  "scopeName": "source.sfml"
}