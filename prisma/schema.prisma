datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  name                   String? @unique
  image                  String?
  bio                    String?
  passwordHash           String?
  emailVerified          DateTime?
  createdAt              DateTime @default(now())
  posts                  Post[]
  ratings                Rating[]
  postCommits            PostCommit[]
  postContributions      PostContributor[]
  comments               Comment[]
  commentVotes           CommentVote[]
  reports                Report[]
  passwordResetTokens    PasswordResetToken[]
  notifications          Notification[]
  accounts               Account[]
  sessions               Session[]
  emailVerificationTokens EmailVerificationToken[]
}

model Category {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  posts Post[]
}

model Tag {
  id    String   @id @default(cuid())
  slug  String   @unique
  name  String
  posts PostTag[]
}

model PostTag {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
  @@index([tagId])
}

model PostImage {
  id       String @id @default(cuid())
  original String
  thumbSm  String
  thumbMd  String
  thumbLg  String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
}

model Rating {
  id      String   @id @default(cuid())
  value   Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  ratedAt DateTime @default(now())

  @@unique([userId, postId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  consumedAt DateTime?
}

enum CodeStatus {
  VERIFIED
  UNVERIFIED
  BROKEN
}

model Dependency {
  id     String @id @default(cuid())
  name   String
  slug   String
  source String
  url    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@index([slug])
  @@index([source])
}

model SfmVersion {
  id          String   @id @default(cuid())
  gameVersion String
  modVersion  String
  source      String
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  fileId     String?
  fileUrl    String?
  uploadedAt DateTime?

  @@unique([gameVersion, modVersion])
  @@index([source])
  @@index([fileId])
  @@index([uploadedAt])
}

model Post {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  modVersion   String
  gameVersion  String
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  authorName   String
  rating       Float        @default(0)
  ratingCount  Int          @default(0)
  ratings      Rating[]
  views        Int          @default(0)
  uploadDate   DateTime     @default(now())
  code         String
  codeStatus   CodeStatus   @default(UNVERIFIED)
  codeNote     String?
  description  String
  youtubeUrl   String?
  images       PostImage[]
  dependencies Dependency[]
  tags         PostTag[]
  openForImprovement Boolean   @default(false)
  currentCommitId   String?      @unique
  currentCommit     PostCommit? @relation("PostCurrentCommit", fields: [currentCommitId], references: [id])
  commits           PostCommit[]
  contributors      PostContributor[]
  comments          Comment[]
  reports           Report[]
}

enum PostCommitStatus {
  PENDING
  MERGED
  REJECTED
}

model PostCommit {
  id          String            @id @default(cuid())
  postId      String
  post        Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String?
  message     String
  code        String
  status      PostCommitStatus  @default(PENDING)
  createdAt   DateTime          @default(now())
  mergedAt    DateTime?
  rejectedAt  DateTime?
  baseCommitId String?
  baseCommit  PostCommit?       @relation("PostCommitBase", fields: [baseCommitId], references: [id])
  derivedCommits PostCommit[]   @relation("PostCommitBase")
  currentForPost Post?          @relation("PostCurrentCommit")

  @@index([postId, createdAt])
  @@index([status])
}

model PostContributor {
  id                  String   @id @default(cuid())
  postId              String
  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mergedCommits       Int      @default(0)
  lastContributionAt  DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, mergedCommits])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  score     Int      @default(0)
  voteCount Int      @default(0)
  votes     CommentVote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports   Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model CommentVote {
  id        String   @id @default(cuid())
  value     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

enum NotificationOrigin {
  SYSTEM
  POST
  REPORT
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  origin    NotificationOrigin
  link      String?
  imageUrl  String?
  metadata  Json?
  createdAt DateTime            @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([postId])
  @@index([commentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
