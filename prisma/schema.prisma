datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?                  @unique
  image                   String?
  bio                     String?
  passwordHash            String?
  emailVerified           DateTime?
  emailNotificationsEnabled Boolean                @default(true)
  emailNotifyPost         Boolean                  @default(true)
  emailNotifySystem       Boolean                  @default(true)
  emailNotifyReport       Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  canCreatePosts          Boolean                  @default(true)
  canCreateComments       Boolean                  @default(true)
  canVotePosts            Boolean                  @default(true)
  canVoteComments         Boolean                  @default(true)
  interactionBanUntil     DateTime?
  posts                   Post[]
  ratings                 Rating[]
  postCommits             PostCommit[]
  postContributions       PostContributor[]
  comments                Comment[]
  commentVotes            CommentVote[]
  reports                 Report[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  reportActions           ReportAction[]           @relation("ReportActionActor")
  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  suggestions             Suggestion[]
  moderatedPosts          Post[]                   @relation("ModeratedPosts")
}

model Category {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  posts Post[]
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
  @@index([tagId])
}

model PostImage {
  id       String @id @default(cuid())
  original String
  thumbSm  String
  thumbMd  String
  thumbLg  String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
}

model Rating {
  id      String   @id @default(cuid())
  value   Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  ratedAt DateTime @default(now())

  @@unique([userId, postId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
}

enum CodeStatus {
  VERIFIED
  UNVERIFIED
  BROKEN
}

model Dependency {
  id     String @id @default(cuid())
  name   String
  slug   String
  source String
  url    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@index([slug])
  @@index([source])
}

model SfmVersion {
  id          String   @id @default(cuid())
  gameVersion String
  modVersion  String
  source      String
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  fileId     String?
  fileUrl    String?
  uploadedAt DateTime?

  @@unique([gameVersion, modVersion])
  @@index([source])
  @@index([fileId])
  @@index([uploadedAt])
}

model ChangelogEntry {
  id          String    @id @default(cuid())
  versionCode String    @unique
  title       String
  body        String
  isLatest    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Post {
  id                    String            @id @default(cuid())
  slug                  String            @unique
  title                 String
  modVersion            String
  gameVersion           String
  categoryId            String
  category              Category          @relation(fields: [categoryId], references: [id])
  authorId              String
  author                User              @relation(fields: [authorId], references: [id])
  authorName            String
  rating                Float             @default(0)
  ratingCount           Int               @default(0)
  workedCount           Int               @default(0)
  brokenCount           Int               @default(0)
  isDeleted             Boolean           @default(false)
  deletionFlaggedAt     DateTime?
  deletionFlaggedByAuto Boolean           @default(false)
  deletionPurgeAt       DateTime?
  moderationEditedAt    DateTime?
  moderationEditedById  String?
  moderationEditedNote  String?
  ratings               Rating[]
  views                 Int               @default(0)
  uploadDate            DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  code                  String
  codeStatus            CodeStatus        @default(UNVERIFIED)
  codeNote              String?
  description           String
  youtubeUrl            String?
  images                PostImage[]
  dependencies          Dependency[]
  tags                  PostTag[]
  openForImprovement    Boolean           @default(false)
  currentCommitId       String?           @unique
  currentCommit         PostCommit?       @relation("PostCurrentCommit", fields: [currentCommitId], references: [id])
  commits               PostCommit[]
  contributors          PostContributor[]
  comments              Comment[]
  reports               Report[]
  moderationEditor      User?             @relation("ModeratedPosts", fields: [moderationEditedById], references: [id])
  searchVector          Unsupported("tsvector")?

  @@index([searchVector], type: Gin)
}

enum PostCommitStatus {
  PENDING
  MERGED
  REJECTED
}

model PostCommit {
  id             String           @id @default(cuid())
  postId         String
  post           Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String?
  message        String
  code           String
  status         PostCommitStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  mergedAt       DateTime?
  rejectedAt     DateTime?
  baseCommitId   String?
  baseCommit     PostCommit?      @relation("PostCommitBase", fields: [baseCommitId], references: [id])
  derivedCommits PostCommit[]     @relation("PostCommitBase")
  currentForPost Post?            @relation("PostCurrentCommit")

  @@index([postId, createdAt])
  @@index([status])
}

model PostContributor {
  id                 String   @id @default(cuid())
  postId             String
  post               Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mergedCommits      Int      @default(0)
  lastContributionAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, mergedCommits])
}

model Comment {
  id                    String        @id @default(cuid())
  postId                String
  post                  Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId              String
  author                User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content               String
  parentId              String?
  parent                Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies               Comment[]     @relation("CommentReplies")
  score                 Int           @default(0)
  voteCount             Int           @default(0)
  isDeleted             Boolean       @default(false)
  deletionFlaggedAt     DateTime?
  deletionFlaggedByAuto Boolean       @default(false)
  deletionPurgeAt       DateTime?
  votes                 CommentVote[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  reports Report[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
}

model Suggestion {
  id           String   @id @default(cuid())
  message      String
  contactName  String?
  contactEmail String?
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model CommentVote {
  id        String   @id @default(cuid())
  value     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

enum NotificationOrigin {
  SYSTEM
  POST
  REPORT
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  origin    NotificationOrigin
  link      String?
  imageUrl  String?
  metadata  Json?
  createdAt DateTime           @default(now())
  readAt    DateTime?
  emailedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, emailedAt])
}

model Report {
  id         String         @id @default(cuid())
  reporterId String
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     ReportReason   @default(OTHER)
  message    String?
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?
  actions    ReportAction[]

  @@index([postId])
  @@index([commentId])
}

model ReportAction {
  id        String           @id @default(cuid())
  reportId  String
  report    Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User             @relation("ReportActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      ReportActionType
  note      String?
  metadata  Json?
  createdAt DateTime         @default(now())
}

enum ReportActionType {
  NOTE
  RESOLVED
  MODERATION
}

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT_OR_BULLYING
  SPREADS_FALSE_INFORMATION
  HATE_SPEECH_OR_SYMBOLS
  PROMOTES_VIOLENCE_OR_DANGEROUS_BEHAVIOR
  PROMOTES_ILLEGAL_ACTIVITY
  PROMOTES_SELF_HARM_OR_SUICIDE
  OTHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
